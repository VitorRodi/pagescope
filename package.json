{
  "name": "rivo-pagescope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A visual X-ray of website performance, powered by Lighthouse reports.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit": "node scripts/audit.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
